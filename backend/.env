# ====================================================
# SISTEMA DE VOTACIÓN ELECTORAL CATA 2026
# Configuración del Entorno y Base de Datos
# ====================================================

# 1. MOTOR DE BASE DE DATOS ('mysql' o 'sqlite')
DB_DRIVER=mysql

# 2. CONFIGURACIÓN UNIVERSAL PARA MYSQL / MARIADB
# Compatible con cualquier servidor MySQL (Docker, XAMPP, cPanel, MariaDB, Remoto)
# El sistema auto-crea la base de datos y todas sus tablas si no existen.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=votacion_cata
DB_USER=root
DB_PASS=cata_root_secret_pass

# En XAMPP estándar local descomentar:
# DB_PORT=3306
# DB_PASS=

# Base de datos única con columna 'sede' (estándar cPanel / hosting): false
# Si se desea bases separadas (_central y _jerusalen): true
DB_SEPARATE_DBS=false

# 3. NOTIFICACIONES WEBHOOK (Opcional)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/nuevo-voto


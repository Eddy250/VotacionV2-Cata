# ====================================================
# SISTEMA DE VOTACIÓN ELECTORAL CATA 2026
# Configuración del Entorno y Base de Datos
# ====================================================

# 1. MOTOR DE BASE DE DATOS (sqlite o mysql)
# Por defecto se utiliza 'sqlite', que contiene todos los padrones y candidatos ya configurados.
DB_DRIVER=sqlite

# 2. CONFIGURACIÓN PARA MYSQL / MARIADB
# (Activar únicamente si en cPanel se configuró base de datos MySQL)
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=votacion_cata
# DB_USER=root
# DB_PASS=

# 3. NOTIFICACIONES WEBHOOK (Opcional)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/nuevo-voto

